generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("GARCOM")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  @@map("user")
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@map("category")
}

model Product {
  id                String              @id @default(cuid())
  name              String              @unique
  description       String?             @db.Text
  price             Float
  image             String?
  available         Boolean             @default(true)
  categoryId        String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  category          Category            @relation(fields: [categoryId], references: [id])
  orderItems        OrderItem[]
  productIngredients ProductIngredient[]
  productModifiers  ProductModifier[]

  @@map("product")
}

model Ingredient {
  id                String              @id @default(cuid())
  name              String              @unique
  unit              String
  currentStock      Float               @default(0)
  minStock          Float               @default(0)
  price             Float               @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  productIngredients ProductIngredient[]
  stockMovements    StockMovement[]

  @@map("ingredient")
}

model ProductIngredient {
  id           String     @id @default(cuid())
  productId    String
  ingredientId String
  quantity     Float
  product      Product    @relation(fields: [productId], references: [id])
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([productId, ingredientId])
  @@map("productingredient")
}

model StockMovement {
  id           String     @id @default(cuid())
  ingredientId String
  type         String
  quantity     Float
  reason       String?    @db.Text
  createdAt    DateTime   @default(now())
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])

  @@map("stockmovement")
}

model Order {
  id           String      @id @default(cuid())
  orderNumber  Int?        // Número sequencial do pedido (opcional para compatibilidade)
  customerName String?     // Nome do cliente (opcional para compatibilidade)
  userId       String
  status       String      @default("PENDING")
  total        Float       @default(0)
  observations String?     @db.Text
  tableNumber  Int?        // Mesa escolhida pelo cliente após o pedido
  dayFinalized Boolean     @default(false) // Marca se o pedido foi finalizado no "Finalizar Dia"
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  user         User        @relation(fields: [userId], references: [id])
  orderItems   OrderItem[]

  @@map("order")
}

model Modifier {
  id          String            @id @default(cuid())
  name        String
  description String?           @db.Text
  type        String            // 'ADD', 'REMOVE', 'REPLACE'
  price       Float             @default(0)
  available   Boolean           @default(true)
  parentId    String?           // Para criar hierarquia de modificadores
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  parent      Modifier?         @relation("ModifierHierarchy", fields: [parentId], references: [id])
  children    Modifier[]        @relation("ModifierHierarchy")
  productModifiers ProductModifier[]
  orderItemModifiers OrderItemModifier[]

  @@map("modifier")
}

model ProductModifier {
  id         String   @id @default(cuid())
  productId  String
  modifierId String
  required   Boolean  @default(false)
  maxQuantity Int?    // Quantidade máxima permitida (null = ilimitado)
  product    Product  @relation(fields: [productId], references: [id])
  modifier   Modifier @relation(fields: [modifierId], references: [id])

  @@unique([productId, modifierId])
  @@map("productmodifier")
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Float
  observations String? @db.Text
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  modifiers OrderItemModifier[]

  @@map("orderitem")
}

model OrderItemModifier {
  id          String    @id @default(cuid())
  orderItemId String
  modifierId  String
  quantity    Int       @default(1)
  price       Float
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  modifier    Modifier  @relation(fields: [modifierId], references: [id])

  @@map("orderitemmodifier")
}
